@using RegistroDoc.Web.Services
@inject UserSession Session
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RegistroDoc</a>
    </div>
</div>

<input type="checkbox" title="Menu de navegação" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                Início
            </NavLink>
        </div>

        @if (Session.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pesquisa">
                    <span class="bi bi-search" aria-hidden="true"></span>
                    Pesquisa
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100"
                        @onclick="Sair">
                    Sair
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    Entrar
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private void Sair()
    {
        Session.SignOut();
        Navigation.NavigateTo("/login");
    }
}
