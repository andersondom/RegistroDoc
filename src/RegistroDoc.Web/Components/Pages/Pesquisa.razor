@page "/pesquisa"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@using System.Net.Http.Json
@using RegistroDoc.Contracts.Search
@using RegistroDoc.Web.Services
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Pesquisa - RegistroDoc</PageTitle>

<h1>Pesquisa de documentos</h1>
<p class="text-muted">
    Localize habilitações de casamento pelo conteúdo indexado do PDF.
</p>

<div class="card mb-4">
    <div class="card-body">
        <EditForm Model="_filtro" OnValidSubmit="PesquisarAsync" FormName="pesquisa">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="termo">Texto</label>
                    <InputText id="termo"
                               class="form-control"
                               @bind-Value="_filtro.Termo"
                               placeholder="Nome, termo ou conteúdo do documento" />
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="ano">Ano</label>
                    <InputNumber id="ano"
                                 class="form-control"
                                 @bind-Value="_filtro.AnoReferencia" />
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100"
                            type="submit"
                            disabled="@_carregando">
                        @(_carregando ? "Pesquisando..." : "Pesquisar")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="alert alert-danger" role="alert">@_erro</div>
}

@if (_resultado is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>@_resultado.TotalItens resultado(s)</strong>
        <span>Página @_resultado.Pagina de @Math.Max(1, _resultado.TotalPaginas)</span>
    </div>

    @if (_resultado.Itens.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum documento encontrado para os critérios informados.
        </div>
    }
    else
    {
        @foreach (var item in _resultado.Itens)
        {
            <article class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">@item.NomeArquivo</h2>
                    <div class="text-muted mb-2">
                        @item.TipoDocumento
                        @if (item.AnoReferencia.HasValue)
                        {
                            <span> · @item.AnoReferencia</span>
                        }
                        <span> · @item.QuantidadePaginas página(s)</span>
                    </div>

                    @if (item.PaginasEncontradas.Count > 0)
                    {
                        <div class="mb-2">
                            Encontrado na(s) página(s):
                            <strong>@string.Join(", ", item.PaginasEncontradas)</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.Trecho))
                    {
                        <p>@item.Trecho</p>
                    }

                    <a class="btn btn-outline-primary btn-sm"
                       href="@($"/documentos/{item.DocumentoId}/pdf")"
                       target="_blank"
                       rel="noopener">
                        Abrir PDF
                    </a>
                </div>
            </article>
        }

        @if (_resultado.TotalPaginas > 1)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary"
                        disabled="@(_resultado.Pagina <= 1 || _carregando)"
                        @onclick="PaginaAnteriorAsync">
                    Anterior
                </button>
                <button class="btn btn-outline-secondary"
                        disabled="@(_resultado.Pagina >= _resultado.TotalPaginas || _carregando)"
                        @onclick="ProximaPaginaAsync">
                    Próxima
                </button>
            </div>
        }
    }
}

@code {
    [SupplyParameterFromForm(FormName = "pesquisa")]
    private FiltroPesquisa _filtro { get; set; } = new();
    private DocumentoSearchResponse? _resultado;
    private bool _carregando;
    private string? _erro;
    private int _pagina = 1;

    private async Task PesquisarAsync()
    {
        _pagina = 1;
        await CarregarAsync();
    }

    private async Task PaginaAnteriorAsync()
    {
        if (_pagina > 1)
        {
            _pagina--;
            await CarregarAsync();
        }
    }

    private async Task ProximaPaginaAsync()
    {
        if (_resultado is not null && _pagina < _resultado.TotalPaginas)
        {
            _pagina++;
            await CarregarAsync();
        }
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;

        try
        {
            var parametros = new List<string>
            {
                $"Pagina={_pagina}",
                "TamanhoPagina=20",
                "TipoDocumento=HabilitacaoCasamento"
            };

            if (!string.IsNullOrWhiteSpace(_filtro.Termo))
            {
                parametros.Add(
                    $"Termo={Uri.EscapeDataString(_filtro.Termo.Trim())}");
            }

            if (_filtro.AnoReferencia.HasValue)
            {
                parametros.Add($"AnoReferencia={_filtro.AnoReferencia.Value}");
            }

            var client = HttpClientFactory.CreateClient("RegistroDoc.Api");
            _resultado = await client.GetFromJsonAsync<DocumentoSearchResponse>(
                "api/documentos/pesquisa?" + string.Join("&", parametros));

            if (_resultado is null)
            {
                _erro = "A API não retornou uma resposta válida.";
            }
        }
        catch (HttpRequestException ex)
        {
            _erro = $"Não foi possível consultar a API: {ex.Message}";
        }
        finally
        {
            _carregando = false;
        }
    }

    private sealed class FiltroPesquisa
    {
        public string? Termo { get; set; }
        public int? AnoReferencia { get; set; }
    }
}
