@page "/pesquisa"
@page "/pesquisa/{Pagina:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = RegistroDoc.Contracts.Security.AccessRoles.Leitura)]
@using System.Net.Http.Json
@using RegistroDoc.Contracts.Search
@using RegistroDoc.Web.Services
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Pesquisa - RegistroDoc</PageTitle>

<header class="search-heading">
<span class="eyebrow">EXPLORE SEU ACERVO</span>
<h1>Pesquisa de documentos</h1>
<p class="text-muted mb-0">
    Localize documentos pelo conteúdo pesquisável dos PDFs.
</p>
</header>

<div class="card mb-4 search-filter">
    <div class="card-body">
        <form method="get" action="/pesquisa" data-enhance="false">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="termo">Texto</label>
                    <input id="termo" name="Termo"
                               class="form-control"
                               value="@Termo"
                               placeholder="Nome, termo ou conteúdo do documento" />
                </div>

                <div class="col-md-2">
                    <label class="form-label" for="ano">Ano</label>
                    <input id="ano" name="AnoReferencia" type="number"
                                 class="form-control"
                                 value="@AnoReferencia" />
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="categoria">Categoria</label>
                    <select id="categoria" name="TipoDocumento" class="form-control">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(TipoDocumento))">Todas as categorias</option>
                        @foreach (var tipo in _tipos)
                        {
                            <option value="@tipo" selected="@(tipo == TipoDocumento)">@NomeCategoria(tipo)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100"
                            type="submit"
                            disabled="@_carregando">
                        @(_carregando ? "Pesquisando..." : "Pesquisar")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="alert alert-danger" role="alert">@_erro</div>
}

@if (_resultado is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>@_resultado.TotalItens resultado(s)</strong>
        <span>Página @_resultado.Pagina de @Math.Max(1, _resultado.TotalPaginas)</span>
    </div>

    @if (_resultado.Itens.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum documento encontrado para os critérios informados.
        </div>
    }
    else
    {
        @if (_resultado.TotalPaginas > 1)
        {
            @ControlesPaginacao
        }

        @foreach (var item in _resultado.Itens)
        {
            <article class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">@item.NomeArquivo</h2>
                    <div class="text-muted mb-2">
                        @NomeCategoria(item.TipoDocumento)
                        @if (item.AnoReferencia.HasValue)
                        {
                            <span> · @item.AnoReferencia</span>
                        }
                        <span> · @item.QuantidadePaginas página(s)</span>
                    </div>

                    @if (item.PaginasEncontradas.Count > 0)
                    {
                        <div class="mb-2">
                            Encontrado na(s) página(s):
                            <strong>@string.Join(", ", item.PaginasEncontradas)</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.Trecho))
                    {
                        <p>@item.Trecho</p>
                    }

                    <a class="btn btn-outline-primary btn-sm"
                       href="@($"/documentos/{item.DocumentoId}/pdf")"
                       target="_blank"
                       rel="noopener">
                        Abrir PDF
                    </a>
                </div>
            </article>
        }

        @if (_resultado.TotalPaginas > 1)
        {
            @ControlesPaginacao
        }
    }
}

@code {
    private static string NomeCategoria(string tipo) => tipo switch
    {
        "HabilitacaoCasamento" => "Habilitações",
        "Averbacao" => "Averbações",
        "Adocao" => "Nascimento e Óbito · Adoção",
        "AverbacaoNascimentoObito" => "Nascimento e Óbito · Averbações",
        "DeclaracaoNascimento" => "Declaração de Nascimento",
        "DeclaracaoObito" => "Declaração de Óbito",
        "LivroNascimentoObito" => "Livros de Nascimento e Óbito",
        "ProtocoloNascimentoObito" => "Protocolos de Nascimento e Óbito",
        "ReconhecimentoPaternidade" => "Reconhecimento de Paternidade",
        "SuprimentoAssentoNascimento" => "Suprimento de Assento Nascimento",
        "SuprimentoObito" => "Suprimento de Óbito",
        "ReconhecimentoFirma" => "Reconhecimento de Firmas",
        "ReconhecimentoMudancaGenero" => "Reconhecimento de Mudança de Gênero",
        "RequerimentoMudancaNome" => "Requerimento de Mudança de Nome",
        _ => tipo
    };
    private RenderFragment ControlesPaginacao => @<nav class="d-flex gap-2 mb-3"
        aria-label="Paginação dos resultados">
        <a class="btn btn-outline-secondary @(_resultado!.Pagina <= 1 ? "disabled" : "")"
           href="@ObterUrlPagina(_resultado.Pagina - 1)"
           aria-disabled="@(_resultado.Pagina <= 1)">
            Anterior
        </a>
        <a class="btn btn-outline-secondary @(_resultado.Pagina >= _resultado.TotalPaginas ? "disabled" : "")"
           href="@ObterUrlPagina(_resultado.Pagina + 1)"
           aria-disabled="@(_resultado.Pagina >= _resultado.TotalPaginas)">
            Próxima
        </a>
    </nav>;

    [SupplyParameterFromQuery]
    public string? Termo { get; set; }
    [SupplyParameterFromQuery]
    public int? AnoReferencia { get; set; }
    [SupplyParameterFromQuery]
    public string? TipoDocumento { get; set; }
    private IReadOnlyList<string> _tipos = Array.Empty<string>();
    private DocumentoSearchResponse? _resultado;
    private bool _carregando;
    private string? _erro;
    [Parameter]
    public int Pagina { get; set; } = 1;

    private int _pagina = 1;


    protected override async Task OnParametersSetAsync()
    {
        _pagina = Math.Max(1, Pagina);
        await CarregarAsync();
    }

    private string ObterUrlPagina(int pagina)
    {
        var parametros = new List<string>();

        if (!string.IsNullOrWhiteSpace(Termo))
            parametros.Add($"Termo={Uri.EscapeDataString(Termo.Trim())}");

        if (AnoReferencia.HasValue)
            parametros.Add($"AnoReferencia={AnoReferencia.Value}");

        if (!string.IsNullOrWhiteSpace(TipoDocumento))
            parametros.Add($"TipoDocumento={Uri.EscapeDataString(TipoDocumento.Trim())}");

        var query = parametros.Count > 0 ? "?" + string.Join("&", parametros) : string.Empty;
        return $"/pesquisa/{Math.Max(1, pagina)}{query}";
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;
        _resultado = null;

        try
        {
            var parametros = new List<string>
            {
                $"Pagina={_pagina}",
                "TamanhoPagina=20"
            };

            if (!string.IsNullOrWhiteSpace(Termo))
            {
                parametros.Add(
                    $"Termo={Uri.EscapeDataString(Termo.Trim())}");
            }

            if (AnoReferencia.HasValue)
            {
                parametros.Add($"AnoReferencia={AnoReferencia.Value}");
            }

            var client = HttpClientFactory.CreateClient("RegistroDoc.Api");
            _tipos = await client.GetFromJsonAsync<List<string>>("api/documentos/tipos") ?? new();
            if (!string.IsNullOrWhiteSpace(TipoDocumento))
                parametros.Add($"TipoDocumento={Uri.EscapeDataString(TipoDocumento.Trim())}");
            _resultado = await client.GetFromJsonAsync<DocumentoSearchResponse>(
                "api/documentos/pesquisa?" + string.Join("&", parametros));

            if (_resultado is null)
            {
                _erro = "A API não retornou uma resposta válida.";
            }
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível consultar a API. Entre novamente se a sessão expirou e tente outra vez.";
        }
        finally
        {
            _carregando = false;
        }
    }

}
