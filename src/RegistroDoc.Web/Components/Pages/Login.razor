@page "/login"

<PageTitle>Entrar - RegistroDoc</PageTitle>

<div class="login-stage">
    <section class="login-story" aria-labelledby="login-intro">
        <span class="eyebrow">REGISTRODOC · ACERVO DIGITAL</span>
        <h1 id="login-intro">Cada documento.<br /><span>Uma história.</span></h1>
        <p>Encontre a informação que você precisa e consulte os documentos do seu acervo em um só lugar.</p>
        <div class="document-art" aria-hidden="true">
            <div class="document-sheet sheet-back"></div>
            <div class="document-sheet sheet-front">
                <span class="document-symbol">RD</span>
                <i></i><i></i><i></i><i></i>
                <span class="document-seal">✓</span>
            </div>
            <span class="art-orbit orbit-one"></span>
            <span class="art-orbit orbit-two"></span>
        </div>
        <span class="story-caption">Organização para o acervo. Agilidade para a rotina.</span>
    </section>
    <section class="login-panel" aria-labelledby="login-title">
        <span class="login-emblem" aria-hidden="true">RD</span>
        <span class="eyebrow">BEM-VINDO</span>
        <h2 id="login-title">Entrar no RegistroDoc</h2>
        <p class="text-muted mb-4">Acesse sua conta para consultar o acervo.</p>

        @if (!string.IsNullOrWhiteSpace(MensagemErro))
        {
            <div class="alert alert-danger" role="alert">@MensagemErro</div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input id="email"
                       name="email"
                       type="email"
                       class="form-control"
                       autocomplete="username"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="senha">Senha</label>
                <input id="senha"
                       name="password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       required />
            </div>

            <button class="btn btn-primary w-100" type="submit">
                Entrar
            </button>
        </form>
        <p class="login-footnote">Pesquisa e documentos disponíveis mediante autenticação.</p>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "erro")]
    public string? Erro { get; set; }

    private string? MensagemErro =>
        Erro switch
        {
            "campos" => "Informe o e-mail e a senha.",
            "credenciais" => "E-mail ou senha inválidos.",
            _ => null
        };
}
